[Unit]
Description=Shorian clinic application (single Node process)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shorian
Group=shorian
WorkingDirectory=/opt/shorian/app
EnvironmentFile=/etc/shorian/environment
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node scripts/deploy-start.mjs
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStartSec=180
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/shorian

[Install]
WantedBy=multi-user.target
